{
  "name": "athens-bus-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "OASA_LIVE=1 vitest run oasa.live",
    "preview": "vite preview",
    "build:stops": "node scripts/build-stops.ts",
    "build:metro": "node scripts/build-metro.ts",
    "build:android": "tsc -b && vite build --mode android && cap sync android",
    "build:android:release": "npm run build:android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "dompurify": "^3.4.17",
    "maplibre-gl": "^6.15.0",
    "oasa-telematics-api": "github:deepblue597/oasa-telematics-api#0a64385f197a1785d05c3d66029b649608daef40",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.3",
    "jsdom": "~30.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
